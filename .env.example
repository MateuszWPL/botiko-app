# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WIDGET_URL=http://localhost:5173

# Database (Supabase pooler URL — IPv4 compatible)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase (https://supabase.com — EU region!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ONLY server-side (api/)!

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=minimum-64-char-hex-string
ENCRYPTION_KEY=minimum-64-char-hex-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
