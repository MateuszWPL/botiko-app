# App
# WAŻNE: na produkcji USTAW JAWNIE NODE_ENV=production.
# DomainWhitelistGuard luzuje sprawdzanie gdy NODE_ENV != 'production'
# (puste allowedDomains = allow all, brak Origin header = allow). Jeśli
# Railway/Vercel nie ustawi tej zmiennej, publiczne endpointy widgetu
# tracą warstwę bezpieczeństwa.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WIDGET_URL=http://localhost:5173

# Database (Supabase pooler URL — IPv4 compatible)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase (https://supabase.com — EU region!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ONLY server-side (api/)!

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=minimum-64-char-hex-string
ENCRYPTION_KEY=minimum-64-char-hex-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email (Resend) — opcjonalne, notifications disabled gdy brak
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=powiadomienia@botiko.pl

# Stripe — opcjonalne, billing disabled gdy brak
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# PRO plan price (opcjonalne — dodaj przy launchu PRO tieru)
STRIPE_PRO_PRICE_ID=price_...

# Cron — min 16 znaków, generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=minimum-16-char-random
