# Prevent committing .env files with secrets
# Matches: .env, .env.local, .env.production, apps/api/.env, apps/web/.env.local etc.
if git diff --cached --name-only | grep -qE '(^|/)\.env(\.|$)'; then
  echo "ERROR: Próbujesz commitować plik .env z sekretami!"
  echo "Pasujące pliki:"
  git diff --cached --name-only | grep -E '(^|/)\.env(\.|$)'
  exit 1
fi
