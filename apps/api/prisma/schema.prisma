generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String    @id @default(cuid())
  name                   String
  websiteUrl             String?
  industry               Industry
  plan                   Plan      @default(STARTER)
  isActive               Boolean   @default(false)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  tokenUsage             Int       @default(0)
  lastTrialEmailSentAt   DateTime?
  createdAt              DateTime  @default(now())
  bots                   Bot[]
  users                  User[]
  leads                  Lead[]
  reviews                Review[]
}

/// Idempotency store for Stripe webhooks. Before processing any event
/// we INSERT the event id; if it conflicts we silently return, guaranteeing
/// that a retried webhook never causes duplicate tenant activation,
/// duplicate emails, or overwritten subscription IDs.
model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Immutable audit trail for billing state changes (audit A13).
/// Written by BillingService on every activation/deactivation. Used for:
///   - Customer support disputes ("when was my account activated?")
///   - Debugging webhook ordering issues
///   - Future revenue analytics
model BillingEvent {
  id         String   @id @default(cuid())
  tenantId   String
  event      String   // e.g. "ACTIVATED", "DEACTIVATED", "PLAN_CHANGED", "TRIAL_EXPIRED"
  meta       String?  // JSON string: e.g. {"stripeEventId":"evt_...","plan":"STARTER"}
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  tenantId     String
  role         UserRole @default(MEMBER)
  emailOptOut  String[] @default([])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailLogs    EmailLog[]
  createdAt    DateTime @default(now())
}

/// Idempotency guard: prevents sending the same drip/onboarding email twice.
model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  sentAt     DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
}

model Bot {
  id                    String         @id @default(cuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  welcomeMsg            String
  primaryColor          String         @default("#6366F1")
  allowedDomains        String[]
  isActive              Boolean        @default(true)
  offlineMessage        String?
  businessHoursStart    Int?
  businessHoursEnd      Int?
  businessDays          Int[]          @default([])
  /// Per-day schedule: [{enabled, start, end}] × 7, index 0=Mon … 6=Sun
  businessSchedule      Json?
  personality           String?
  companyName           String?
  companyPhone          String?
  companyAddress        String?
  suggestedQuestions    String[]       @default([])
  leadFormAfterMessages Int            @default(3)
  avatarEmoji           String         @default("")
  conversations         Conversation[]
  knowledge             KnowledgeChunk[]
  importJobs            KnowledgeImportJob[]
}

model KnowledgeChunk {
  id        String                 @id @default(cuid())
  botId     String
  bot       Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  content   String
  embedding Unsupported("vector(1536)")
  category  String?
  source    String?                @default("manual")
  createdAt DateTime               @default(now())

  @@index([botId, source])
}

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botId     String
  sessionId String?
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  name      String
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  phone     String
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([botId, sessionId])
}

model Conversation {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  sessionId String
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MsgRole
  content        String
  /// True on ASSISTANT messages served from the RAG fallback path (no relevant
  /// knowledge found). Drives the "knowledge base health" indicator — a high
  /// fallback rate means the client's knowledge base is too sparse.
  wasFallback    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, role])
}

model Review {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rating    Int
  message   String?
  userName  String
  userEmail String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum ImportJobStatus {
  PENDING
  SCRAPING
  EXTRACTING
  READY_FOR_REVIEW
  CONFIRMING
  CONFIRMED
  FAILED
  CANCELLED
}

model KnowledgeImportJob {
  id               String          @id @default(cuid())
  tenantId         String
  botId            String
  bot              Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  status           ImportJobStatus @default(PENDING)
  sourceUrl        String
  scrapedPages     String[]        @default([])
  failedPages      String[]        @default([])
  extractedPayload Json?
  chunksCreated    Int             @default(0)
  errorCode        String?
  errorMessage     String?
  tokenUsage       Int             @default(0)
  createdAt        DateTime        @default(now())
  completedAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([botId, status])
}

enum Industry {
  BEAUTY
  HEALTH
  FOOD
  AUTO
  OTHER
}

enum Plan {
  STARTER
  PRO
  PREMIUM
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum MsgRole {
  USER
  ASSISTANT
}

enum UserRole {
  OWNER
  MEMBER
}
