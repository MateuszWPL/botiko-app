generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String    @id @default(cuid())
  name                   String
  industry               Industry
  plan                   Plan      @default(STARTER)
  isActive               Boolean   @default(false)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  tokenUsage             Int       @default(0)
  lastTrialEmailSentAt   DateTime?
  createdAt              DateTime  @default(now())
  bots                   Bot[]
  users                  User[]
  leads                  Lead[]
}

/// Idempotency store for Stripe webhooks. Before processing any event
/// we INSERT the event id; if it conflicts we silently return, guaranteeing
/// that a retried webhook never causes duplicate tenant activation,
/// duplicate emails, or overwritten subscription IDs.
model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Immutable audit trail for billing state changes (audit A13).
/// Written by BillingService on every activation/deactivation. Used for:
///   - Customer support disputes ("when was my account activated?")
///   - Debugging webhook ordering issues
///   - Future revenue analytics
model BillingEvent {
  id         String   @id @default(cuid())
  tenantId   String
  event      String   // e.g. "ACTIVATED", "DEACTIVATED", "PLAN_CHANGED", "TRIAL_EXPIRED"
  meta       String?  // JSON string: e.g. {"stripeEventId":"evt_...","plan":"STARTER"}
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  tenantId  String
  role      UserRole @default(MEMBER)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Bot {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  welcomeMsg         String
  primaryColor       String         @default("#6366F1")
  allowedDomains     String[]
  isActive           Boolean        @default(true)
  offlineMessage     String?
  businessHoursStart Int?
  businessHoursEnd   Int?
  businessDays       Int[]          @default([])
  conversations      Conversation[]
  knowledge          KnowledgeChunk[]
}

model KnowledgeChunk {
  id        String                 @id @default(cuid())
  botId     String
  bot       Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  content   String
  embedding Unsupported("vector(1536)")
  category  String?
  createdAt DateTime               @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botId     String
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  name      String
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  phone     String
  /// @encrypted AES-256-GCM — format {iv}:{authTag}:{ciphertext} (hex)
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  sessionId String
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MsgRole
  content        String
  createdAt      DateTime     @default(now())
}

enum Industry {
  BEAUTY
  HEALTH
  FOOD
  AUTO
  OTHER
}

enum Plan {
  STARTER
  PRO
  PREMIUM
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum MsgRole {
  USER
  ASSISTANT
}

enum UserRole {
  OWNER
  MEMBER
}
